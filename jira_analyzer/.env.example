# ============================================================
#   ТОКЕНЫ — единственное место, куда нужно что-то вставлять
#   (суффикс может быть _TOKEN или _PAT — читаются оба;
#    перед работой скопируй этот файл в .env и заполни)
# ============================================================
JIRA_TOKEN=
JIRA_DELTA_TOKEN=

# ============================================================
#   АДРЕСА И РЕЖИМЫ (подставь свои адреса корпоративных Jira)
# ============================================================
JIRA_URL=https://jira.corp-1.local
JIRA_AUTH=bearer

JIRA_DELTA_URL=https://jira.corp-2.local
JIRA_DELTA_AUTH=bearer

# Открытый тестовый стенд (Apache Jira, анонимно, без токена)
APACHE_URL=https://issues.apache.org/jira
APACHE_AUTH=none

# ==== Результаты ====
DATA_DIR=data

# ==== Fetch: переопределяют config/settings.json ====
# FETCH_DELAY=0.3
# FETCH_MAX_RETRIES=5
# FETCH_TIMEOUT=30
# FETCH_BACKOFF_STEP=1.0
# FETCH_PAGE_SIZE=100
# FETCH_EXPAND_BATCH=50
# FETCH_WITH_COMMENTS=false
# FETCH_DATE_FROM=2024-01-01
# FETCH_DATE_TO=2025-01-01

# --- web ---
# Порт web-интерфейса (python -m src.web.app), по умолчанию 8765
# WEB_PORT=8765
