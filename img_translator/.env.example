# Дефолты web-интерфейса передатчика (см. ENV_FILE в server/app.py).
# Файл опционален: нет файла или кривое значение → встроенный дефолт.

# Сетка кадра, ячеек: 16..512
GRID_W=128
GRID_H=96

# Размер ячейки на странице, px: 2..32
CELL_PX=10

# Число цветов: 2 / 4 / 8 / 16
COLORS=16

# Пауза между кадрами, мс: >= 50
DELAY_MS=500

# Крутить кадры по кругу: true / false
LOOP=true

# Папка (или файл), выбранная по умолчанию при открытии страницы.
# Относительный путь — от корня проекта. Пусто или путь не существует —
# ничего не выбрано. Можно удалять/добавлять в интерфейсе как обычно.
# DEFAULT_FOLDER=tests

# Базовая папка для результатов приёмника: внутри неё создаётся
# папка с именем-датой (YYYYMMDD-HHMMSS). Относительный путь — от текущей
# папки запуска приёмника; пусто или ключа нет — received/.
# OUT_DIR=~/imgtr_results

